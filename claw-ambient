"""claw-ambient: screen-reactive ambient lighting for the MSI Claw joystick RGB rings.

Samples the screen and sets the ring colour to match (Ambilight style).
Works in Steam Game Mode (gamescope PipeWire node) and on Wayland desktops
(xdg-desktop-portal screencast; asks once, then remembers).

Colours are streamed straight to the controller over hidraw WITHOUT the SYNC_TO_ROM
command the kernel driver sends, so nothing is written to the MCU's flash and fades
are not held back by the driver's 50 ms debounce.
"""
import glob
import json
import os
import subprocess
import sys
import time

import numpy as np
import gi

gi.require_version("Gst", "1.0")
gi.require_version("GLib", "2.0")
from gi.repository import Gio, GLib, Gst  # noqa: E402

# ---- defaults (override in ~/.config/claw-ambient/config) --------------------
SETTINGS = {
    "fps": 30,              # screen samples per second
    "led_hz": 60,           # LED fade steps per second
    "fade_seconds": 0.10,   # how long colour changes take to settle (higher = smoother/slower)
    "saturation": 1.6,      # >1 makes colours punchier
    "min_level": 0.08,      # dimmest the rings go on dark scenes (0..1)
    "max_level": 1.0,       # overall brightness cap (0..1)
    "gamma": 1.8,           # LED colour curve
    "keepalive": 1.0,       # resend the colour this often on a static screen (s)
}
# -----------------------------------------------------------------------------

CONFIG_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                           "claw-ambient", "config")


def load_config():
    """Read `key = value` lines; unknown keys and bad values are reported and ignored."""
    if not os.path.exists(CONFIG_FILE):
        return
    for n, line in enumerate(open(CONFIG_FILE), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        key, _, val = (x.strip() for x in line.partition("="))
        if key not in SETTINGS:
            print(f"{CONFIG_FILE}:{n}: unknown setting '{key}'", file=sys.stderr)
            continue
        try:
            SETTINGS[key] = type(SETTINGS[key])(float(val))
        except ValueError:
            print(f"{CONFIG_FILE}:{n}: bad value for '{key}': {val!r}", file=sys.stderr)


STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
                         "claw-ambient")
TOKEN_FILE = os.path.join(STATE_DIR, "restore_token")

CLAW_PIDS = ("00001901", "00001902", "00001903", "00001904")


class ClawRGB:
    """Live RGB over hidraw: WRITE_PROFILE_DATA (0x21) only, never SYNC_TO_ROM (0x22)."""

    def __init__(self):
        self.path = self._find()
        try:
            self.fd = os.open(self.path, os.O_RDWR | os.O_NONBLOCK)
        except PermissionError:
            raise SystemExit(f"No permission to open {self.path}. Is 70-claw-ambient.rules installed "
                             "in /etc/udev/rules.d/ (then log out and back in)?")
        bcd = int(open(self._usb_attr("bcdDevice")).read(), 16)
        major, minor = bcd >> 8, bcd & 0xFF
        new = (major == 1 and minor >= 0x66) or (major == 2 and minor >= 0x17) or major >= 3
        self.addr = 0x024A if new else 0x01FA   # same rule as the kernel's claw_features_supported()

    def _find(self):
        for d in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
            ue = open(f"{d}/device/uevent").read().upper()
            if "0DB0:" in ue and any(p in ue for p in CLAW_PIDS) and "/INPUT1\n" in ue:
                self.sys = d
                return "/dev/" + os.path.basename(d)
        raise SystemExit("MSI Claw controller not found (needs the hid-msi driver and an MSI Claw)")

    def _usb_attr(self, name):
        d = os.path.realpath(f"{self.sys}/device")
        while d != "/" and not os.path.exists(f"{d}/{name}"):
            d = os.path.dirname(d)
        return f"{d}/{name}"

    def set(self, r, g, b):
        body = bytes([0x01, self.addr >> 8, self.addr & 0xFF, 0x24, 0x00, 1, 0x09, 0, 100])
        pkt = bytes([0x0F, 0, 0, 0x3C, 0x21]) + body + bytes([r, g, b]) * 9
        os.write(self.fd, pkt.ljust(64, b"\0"))
        try:                                # drain the MCU's ACKs
            while os.read(self.fd, 64):
                pass
        except BlockingIOError:
            pass


def find_gamescope_node():
    try:
        dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, timeout=5).stdout)
    except Exception:
        return None
    for obj in dump:
        props = (obj.get("info") or {}).get("props") or {}
        if props.get("node.name") == "gamescope" and props.get("media.class") == "Video/Source":
            return obj["id"]
    return None


class Portal:
    """Minimal xdg-desktop-portal ScreenCast client."""

    def __init__(self):
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.sender = self.bus.get_unique_name()[1:].replace(".", "_")
        self.n = 0

    def _call(self, method, params, fds=None):
        return self.bus.call_with_unix_fd_list_sync(
            "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
            "org.freedesktop.portal.ScreenCast", method, params, None,
            Gio.DBusCallFlags.NONE, -1, fds, None)

    def _request(self, method, build):
        self.n += 1
        token = f"clawambient{os.getpid()}_{self.n}"
        path = f"/org/freedesktop/portal/desktop/request/{self.sender}/{token}"
        loop, result = GLib.MainLoop(), {}

        def on_response(_c, _s, _p, _i, _sig, params):
            code, res = params.unpack()
            result["code"], result["res"] = code, res
            loop.quit()

        sub = self.bus.signal_subscribe(
            "org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response",
            path, None, Gio.DBusSignalFlags.NO_MATCH_RULE, on_response)
        self._call(method, build(token))
        loop.run()
        self.bus.signal_unsubscribe(sub)
        if result["code"] != 0:
            raise RuntimeError(f"screen sharing {method} was cancelled or failed ({result['code']})")
        return result["res"]

    def open(self):
        res = self._request("CreateSession", lambda t: GLib.Variant(
            "(a{sv})", ({"handle_token": GLib.Variant("s", t),
                         "session_handle_token": GLib.Variant("s", t + "s")},)))
        session = res["session_handle"]

        opts = {"types": GLib.Variant("u", 1), "multiple": GLib.Variant("b", False),
                "cursor_mode": GLib.Variant("u", 1), "persist_mode": GLib.Variant("u", 2)}
        if os.path.exists(TOKEN_FILE):
            opts["restore_token"] = GLib.Variant("s", open(TOKEN_FILE).read().strip())
        self._request("SelectSources", lambda t: GLib.Variant(
            "(oa{sv})", (session, {**opts, "handle_token": GLib.Variant("s", t)})))

        res = self._request("Start", lambda t: GLib.Variant(
            "(osa{sv})", (session, "", {"handle_token": GLib.Variant("s", t)})))
        if "restore_token" in res:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(TOKEN_FILE, "w") as f:
                f.write(res["restore_token"])
        node_id = res["streams"][0][0]

        ret, fdlist = self._call("OpenPipeWireRemote", GLib.Variant("(oa{sv})", (session, {})))
        fd = fdlist.get(ret.unpack()[0])
        return fd, node_id


def colour_from_frame(buf, w, h):
    px = np.frombuffer(buf, np.uint8)[: w * h * 3].reshape(-1, 3).astype(np.float32) / 255.0
    mx, mn = px.max(1), px.min(1)
    sat = (mx - mn) / (mx + 1e-6)
    weight = sat * sat * mx + 0.02          # favour vivid, bright pixels
    col = (px * weight[:, None]).sum(0) / weight.sum()
    level = float(np.clip(mx.mean() * 1.4, SETTINGS["min_level"], 1.0)) * SETTINGS["max_level"]
    grey = col.mean()
    col = np.clip(grey + (col - grey) * SETTINGS["saturation"], 0, 1)
    col = col / max(col.max(), 1e-3)
    return col * level


def main():
    load_config()
    fps, led_hz, fade = SETTINGS["fps"], SETTINGS["led_hz"], SETTINGS["fade_seconds"]
    Gst.init(None)
    leds = ClawRGB()
    print(f"Controller: {leds.path} (RGB addr 0x{leds.addr:04x})", flush=True)

    node = None
    desktop = os.environ.get("XDG_CURRENT_DESKTOP", "").lower()
    for _ in range(10):                     # gamescope node can appear a moment after login
        node = find_gamescope_node()
        if node is not None or (desktop and "gamescope" not in desktop):
            break
        time.sleep(1)

    # Ask the compositor to send only as many frames as we sample, instead of copying every
    # frame at display refresh rate and dropping most of them.
    cap = f" ! video/x-raw,max-framerate={fps}/1"
    if node is not None:
        print(f"Using gamescope capture (node {node})", flush=True)
        src = f"pipewiresrc path={node} do-timestamp=true"
        portal = None
        can_uncap = True                    # untested cap: fall back to uncapped if it fails
    else:
        print("Using desktop screen-share portal", flush=True)
        portal = Portal()                   # keep reference: session lives with the D-Bus connection
        fd, node = portal.open()
        src = f"pipewiresrc fd={fd} path={node} do-timestamp=true"
        can_uncap = False                   # the portal fd can't be reused for a second pipeline

    W, H = 96, 54

    def start(capped):
        pl = Gst.parse_launch(
            f"{src}{cap if capped else ''} ! videorate drop-only=true max-rate={fps} ! videoscale ! "
            f"video/x-raw,width={W},height={H} ! videoconvert ! video/x-raw,format=RGB ! "
            "appsink name=sink max-buffers=1 drop=true sync=false")
        pl.set_state(Gst.State.PLAYING)
        return pl, pl.get_by_name("sink"), pl.get_bus()

    capped = True
    pipeline, sink, bus = start(capped)
    started, got_frame = time.monotonic(), False

    target, smooth, last = None, None, None
    prev = last_sent = time.monotonic()
    try:
        while True:
            msg = bus.pop_filtered(Gst.MessageType.ERROR | Gst.MessageType.EOS)
            stalled = not got_frame and time.monotonic() - started > 10
            if capped and can_uncap and (msg or stalled):
                why = msg.parse_error()[0].message if msg and msg.type == Gst.MessageType.ERROR else "no frames"
                print(f"Frame-rate cap not accepted ({why}); capturing uncapped", flush=True)
                pipeline.set_state(Gst.State.NULL)
                capped = False
                pipeline, sink, bus = start(capped)
                started = time.monotonic()
                continue
            if msg:
                err = msg.parse_error()[0].message if msg.type == Gst.MessageType.ERROR else "stream ended"
                print(f"Capture stopped: {err}", file=sys.stderr)
                return 1
            # While fading, wait for a frame only until the next LED tick so the fade keeps moving
            # on a static screen. Once settled, sleep until a new frame or the keepalive is due.
            settled = smooth is not None and float(np.abs(target - smooth).max()) < 1e-3
            wait = SETTINGS["keepalive"] if settled else 1.0 / led_hz
            sample = sink.emit("try-pull-sample", int(Gst.SECOND * wait))
            if sample is not None:
                if not got_frame:
                    got_frame = True
                    print(f"Capturing{f' at up to {fps} fps' if capped else ' (uncapped)'}", flush=True)
                buf = sample.get_buffer()
                ok, info = buf.map(Gst.MapFlags.READ)
                if ok:
                    try:
                        target = colour_from_frame(info.data, W, H)
                    finally:
                        buf.unmap(info)
            if target is None:
                continue
            now = time.monotonic()
            dt, prev = now - prev, now
            if smooth is None:
                smooth = target.copy()
            else:
                smooth += (target - smooth) * (1.0 - np.exp(-dt / fade))
            # Fade in perceptual space, convert to LED drive level on output.
            out = tuple(int(round(v)) for v in (np.clip(smooth, 0, 1) ** SETTINGS["gamma"]) * 255)
            if out != last or now - last_sent >= SETTINGS["keepalive"]:
                leds.set(*out)
                last, last_sent = out, now
    finally:
        pipeline.set_state(Gst.State.NULL)


if __name__ == "__main__":
    sys.exit(main())
